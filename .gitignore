# Haunted House Adventure Game - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# Poetry
poetry.lock
.poetry/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Game-specific
savegame.pkl
savegame_*.pkl
*.save
game_stats.json
achievements.json

# Audio (keep in repo, but ignore user recordings if added later)
# haloweenmusic.mp3 is tracked

# Logs
*.log
debug.log

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/
